<Window x:Class="SudokuProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SudokuProject.Controls"
        Title="WPF Sudoku" Height="600" Width="500">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Game">
                <MenuItem Header="New Easy" Click="MenuNewEasy_Click"/>
                <MenuItem Header="New Hard" Click="MenuNewHard_Click"/>
                <Separator/>
                <MenuItem Header="Save to XML" Click="MenuSave_Click"/>
                <MenuItem Header="Load XML" Click="MenuLoad_Click"/>
            </MenuItem>
            <MenuItem Header="Actions">
                <MenuItem Header="Undo" Click="MenuUndo_Click"/>
                <MenuItem Header="Redo" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem Header="Check for Mistakes" Click="MenuCheckMistakes_Click"/>
                <MenuItem Header="Solve Puzzle" Click="MenuSolve_Click"/>
                <MenuItem Header="Check if Solved" Click="MenuCheck_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="TimerText" Text="Time: 00:00" FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>

        <controls:SudokuBoardControl x:Name="BoardControl" Margin="10"/>
    </DockPanel>
</Window>